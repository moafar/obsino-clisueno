# ----------------------
# Python
# ----------------------
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# ----------------------
# IDE
# ----------------------
.vscode/

# ----------------------
# Entornos
# ----------------------
.env
.env.*

# ----------------------
# Logs
# ----------------------
*.log
logs/**/*.log
extract/logs/**/*.log
!logs/.gitkeep

# ----------------------
# Outputs / Procesados
# ----------------------
output/**/*
!output/.gitkeep
extract/output/**/*
!extract/output/.gitkeep
extract/procesados/**/*
!extract/procesados/.gitkeep
procesados/**/*
!procesados/.gitkeep

# ----------------------
# Datos
# ----------------------
*.csv
*.xlsx

# ----------------------
# Archivos de prueba
# ----------------------
**/test_files/
**/test_files_copy/
test_files_global/
test_files_global_copy/

# ----------------------
# Secretos
# ----------------------
secrets/*.json
**/secrets/*.json
!secrets/.gitkeep
!**/secrets/.gitkeep
