# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# IDE
.vscode/

# Env files
.env
.env.*

# Logs
*.log
extract/logs/**/*.log

# Generated outputs / processed data
extract/output/**/*
!extract/output/.gitkeep
extract/procesados/**/*
!extract/procesados/.gitkeep

# Datos
*.csv
*.xlsx

# Test input copies
**/test_files/
**/test_files_copy/
test_files_global/
test_files_global_copy/

# Secretos
# Keep service-account JSONs untracked in any layer
**/secrets/*.json
!**/secrets/.gitkeep
