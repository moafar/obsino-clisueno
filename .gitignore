# ----------------------
# Python
# ----------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ----------------------
# Logs y salidas
# ----------------------
logs/**/*.log
!logs/.gitkeep
output/**/*
!output/.gitkeep
*.log

# ----------------------
# Datos
# ----------------------
*.csv
*.xlsx

# ----------------------
# Entornos
# ----------------------
.env
.env.*

# ----------------------
# VS Code
# ----------------------
.vscode/

# ----------------------
# Secretos
# ----------------------
secrets/*.json
!secrets/.gitkeep

# ----------------------
# Archivos de prueba
# ----------------------
**/test_files/
**/test_files_copy/
test_files_global/
test_files_global_copy/


# ----------------------
# Procesados
# ----------------------
procesados/**/*
!procesados/.gitkeep
